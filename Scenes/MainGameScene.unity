  m_Script: {fileID: 11500000, guid: ee5b58340c105944ebaf323ba885c916, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Friend Confession Male
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 457801ba2ecba2a4799e06e6451bbf2c, type: 3}
    - {fileID: 8300000, guid: 18365e8a33bf8ee49b213599a943980d, type: 3}
    - {fileID: 8300000, guid: efba3d8df34960a49b5c94b627edcc88, type: 3}
    - {fileID: 8300000, guid: 432ccd72e9ecf3e47ae5aa29b710a81d, type: 3}
    dialogueLines:
    - '|Dimas| ada hal penting yang harus saya bicarakan.| Ini tentang kondisi kesehatan
      saya.'
    - "Sebenarnya sudah lama ingin saya sampaikan, tapi terlalu banyak pertimbangan,| 
      jadi selalu saya tunda.| Hari ini saya putuskan| untuk jujur ke kamu sebagai
      sahabat. Bahkan,| keluarga saya pun belum tahu.\r"
    - Saya tahu ini mungkin berat| atau membuatmu kaget.| Kondisi saya saat ini |
      positif HIV.
    - "Saya hanya mau jujur|| dan saya sangat berharap kita tetap bisa bersahabat| 
      setelah kamu tahu ini.\r"
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1371919721}
          m_TargetAssemblyTypeName: SimulationRoomScript, Assembly-CSharp
          m_MethodName: ScenarioTrigger
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Teman
            m_BoolArgument: 0
          m_CallState: 2
