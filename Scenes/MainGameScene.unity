  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Parent Confession Female
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 7441623b53d6dec40868ca69bfd5c767, type: 3}
    dialogueLines:
    - "|Ayah,| Ibu,|| ada hal penting yang harus saya bicarakan tentang kondisi kesehatan
      saya||\r\nSaya tahu ini terkesan mendadak, tapi saya minta kita duduk sebentar|
      dan mendengarkan apa yang akan saya bicarakan||\r\nSebenarnya sudah lama ingin
      saya ceritakan bahwa saya| positif HIV| dan baru tahu sejak beberapa minggu
      yang lalu||\r\nSaya tahu ini mengejutkan, tapi saya tidak mau menyembunyikan
      ini dari ayah dan ibu||\r\nSaya sedang berobat| dan saya merasa sehat.\r"
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1371919721}
          m_TargetAssemblyTypeName: SimulationRoomScript, Assembly-CSharp
          m_MethodName: ScenarioTrigger
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Ortu
            m_BoolArgument: 0
          m_CallState: 2
