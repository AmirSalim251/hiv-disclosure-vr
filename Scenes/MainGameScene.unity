    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 77a936ed42f6750459b6da68b0f70920, type: 3}
    dialogueLines:
    - "Ayah, Ibu, saya tidak bohong. Saya sudah tes dan diagnosisnya jelas positif.
      Saya juga sudah mulai pengobatan|\r\nWalaupun HIV belum bisa disembuhkan, tapi
      bisa \r\ndikendalikan dengan pengobatan yang teratur|\r\nSaya bisa tetap sehat,
      bekerja, dan hidup normal, terlebih jika disupport oleh ayah dan ibu."
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
