  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Husband Response
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 71039c4c1dc35134fa48495504d56414, type: 3}
    - {fileID: 8300000, guid: 35653df08fa17414cb24af2ee9819d71, type: 3}
    - {fileID: 8300000, guid: a293414d8e2b2144284b8c3a1e0f19d3, type: 3}
    dialogueLines:
    - '|Saya tahu| kamu pasti merasa dikhianati, tapi tolong,|| dengarkan saya dulu
      sebelum kamu mengambil kesimpulan.'
    - Ini bukan karena perselingkuhan|| ataupun ketidaksetiaan. Ini dari masa lalu
      saya| yang pernah melakukan seks bebas.
    - Saya baru tahu status ini setelah pemeriksaan|| dan sudah langsung mulai pengobatan.|
      Saya jujur ke kamu hari ini| karena saya sangat menghargai hubungan kita.
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
        m_Calls:
