  m_Script: {fileID: 11500000, guid: ee5b58340c105944ebaf323ba885c916, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Wife Confession
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: cee641cae5f70a841930e757cf4635bb, type: 3}
    dialogueLines:
    - '||Pak, boleh Ibu ngomong sebentar?| Ada hal penting soal kesehatanku yang
      belum pernah Ibu cerita.| Ibu minta| Bapak tolong dengarkan dulu sampai habis
      ya.|| Sudah lama sekali ingin Ibu sampaikan, tapi Ibu selalu tunda karena ||Ibu
      takut dan khawatir.

      |Ini tidak mudah buat Ibu, tapi ibu ingin bapak
      tahu.| Ibu putuskan bicara hari ini demi kebaikan kita, khususnya demi masa
      depan anak kita.|| Ibu baru tahu, kalau ibu positif HIV.| Ibu tahu dari hasil
      tes kesehatan rutin, tapi, ibu sudah langsung mulai pengobatan dan saat ini
      ibu merasa sehat.'
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1371919721}
          m_TargetAssemblyTypeName: SimulationRoomScript, Assembly-CSharp
          m_MethodName: ScenarioTrigger
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Suami
            m_BoolArgument: 0
          m_CallState: 2
