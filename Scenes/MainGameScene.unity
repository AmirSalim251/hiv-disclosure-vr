  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 204412850}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee5b58340c105944ebaf323ba885c916, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Friend Confession Female
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 9c90e79e66f832445a44a7b8319f0cef, type: 3}
    dialogueLines:
    - "|Rina,| ada hal penting yang harus aku bicarakan.| Ini tentang| kondisi kesehatanku.|
      Sebenarnya,| sudah lama ingin aku sampaikan,| tapi terlalu banyak pertimbangan|
      jadi| selalu aku tunda.|\r\n\rHari ini aku putuskan untuk jujur ke kamu sebagai
      sahabat.| Bahkan, keluargaku pun belum tahu.| Aku tahu ini mungkin berat atau
      membuatmu kaget.| Aku| saat ini positif HIV.| Aku cuma mau jujur| dan aku sangat
      berharap kita tetap| bisa bersahabat setelah kamu tahu ini.\r\n\r\n"
