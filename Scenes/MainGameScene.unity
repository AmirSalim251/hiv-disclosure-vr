--- !u!114 &487553343
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 487553341}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee5b58340c105944ebaf323ba885c916, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Husband Confession
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 14d1111298406624595319cab8721882, type: 3}
    - {fileID: 8300000, guid: 8024983ad97dac542a36ba3ef5cedadf, type: 3}
    - {fileID: 8300000, guid: b2250ed045fd2634f997139a5eae10dd, type: 3}
    - {fileID: 8300000, guid: e5c841a0f4aab764f8ee85398a51e672, type: 3}
    dialogueLines:
    - "||Ibu,|| ada hal penting yang harus saya bicarakan.| \nIni tentang kondisi
      kesehatanku|| yang sudah lama ingin saya sampaikan.| Namun banyak pertimbangan|
      dan rasa khawatir yang saya rasakan| sehingga selalu menunda untuk saya sampaikan."
    - '|Dan hari ini saya putuskan untuk menyampaikan| demi kebaikan bersama.'
    - "|Khususnya masa depan anak| dan keluarga besar kita.|\r\n\r\n|Jadi, beberapa
      minggu lalu saya periksa kesehatan secara menyeluruh| dan hasilnya| aku positif
      HIV.\r"
    - '||Saat ini saya sedang berobat| dan saya merasa sehat.'
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1371919721}
          m_TargetAssemblyTypeName: SimulationRoomScript, Assembly-CSharp
          m_MethodName: ScenarioTrigger
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Istri
            m_BoolArgument: 0
          m_CallState: 2
