    dialogueName: Wife Response
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 0cf64af41ab0c794a8d6b08181eca4b7, type: 3}
    dialogueLines:
    - 'Ibu tahu bapak pasti merasa dikhianati, tapi tolong, dengarkan ibu dulu sebelum
      bapak mengambil kesimpulan.

      Ini bukan karena perselingkuhan atau ketidaksetiaan.
      Ini dari masa lalu ibu yang pernah melakukan seks bebas. Ibu baru tahu status
      ini setelah pemeriksaan| dan sudah langsung mulai pengobatan. Ibu jujur ke
      Bapak hari ini karena Ibu sangat menghargai hubungan kita.'
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
