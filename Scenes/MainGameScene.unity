  m_Script: {fileID: 11500000, guid: ee5b58340c105944ebaf323ba885c916, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueName: Parent Confession Male
    audioSource: {fileID: 1730426074}
    textBox: {fileID: 866844928}
    dialogueAudio:
    - {fileID: 8300000, guid: 0ce55ecf44b45054bb00f9b21fc352f0, type: 3}
    - {fileID: 8300000, guid: 937d708d8d9ddcc45862217658b79357, type: 3}
    - {fileID: 8300000, guid: 7b86084659224a54e8df8cfa150e4af2, type: 3}
    - {fileID: 8300000, guid: 7a4c55b14d1f75a4b942a673af7b03e5, type: 3}
    dialogueLines:
    - "|Ayah,| Ibu,| ada hal penting yang harus saya bicarakan| tentang kondisi kesehatan
      saya.\r"
    - "\rSaya tahu ini terkesan mendadak,| tapi saya minta kita duduk sebentar| dan
      mendengarkan apa yang akan saya bicarakan."
    - Sebenarnya,| sudah lama ingin saya ceritakan| bahwa saya positif HIV| dan baru
      tahu sejak beberapa minggu yang lalu.
    - "Saya tahu ini mengejutkan,| tapi saya tidak mau sembunyikan dari kalian. \r\nSaya
      sedang berobat| dan saya merasa sehat."
    preDialogueAction:
      m_PersistentCalls:
        m_Calls: []
    postDialogueAction:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1371919721}
          m_TargetAssemblyTypeName: SimulationRoomScript, Assembly-CSharp
          m_MethodName: ScenarioTrigger
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Ortu
            m_BoolArgument: 0
          m_CallState: 2
